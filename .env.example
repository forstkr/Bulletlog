# Firebase Web App Configuration
# Copy this file to .env and fill in values from Firebase Console -> Project Settings -> Your apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Single-user access control: only this Google account email can access the journal
VITE_ALLOWED_EMAIL="your-email@gmail.com"

# Optional: base URL path for GitHub Pages (e.g., /bulletlog/). Defaults to "/" in local dev.
VITE_BASE_PATH="/"
